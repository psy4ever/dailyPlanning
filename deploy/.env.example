# Template only. Generate real credentials with prepare-mysql-env.py on Ubuntu.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Initial App nickname/legacy login alias and password (different from MySQL).
# The server assigns the first eight-digit UID. Use prepare-api-env.py on Ubuntu.
DAILY_USERNAME=
DAILY_PASSWORD=
# Only needed when enabling compose.https.yaml; DNS must resolve to the server.
API_DOMAIN=
